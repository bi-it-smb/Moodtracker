<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FB10_SMB_MoodTracker.DetailPage"
             Title="Zurück zu Angebote">
    <VerticalStackLayout>
        <Image Source="{Binding Course.Image}" HeightRequest="267" Aspect="AspectFill" Margin="0,0,0,8"/>
        <Label Text="{Binding Course.Name}" FontAttributes="Bold" FontSize="24"/>
        <Label Text="{Binding Course.Description}" FontSize="18"/>
        <Label Text="{Binding Course.Date}" />
        <Label Text="{Binding Course.Time}" />
        <Label Text="{Binding Course.Age}" />
        <Label Text="{Binding Course.Materials}" />
    </VerticalStackLayout>
</ContentPage>
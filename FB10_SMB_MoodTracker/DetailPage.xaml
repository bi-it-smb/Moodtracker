<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FB10_SMB_MoodTracker.DetailPage"
             Title="Zurück zu Angebote">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Image Source="{Binding Course.Image}" 
                   HeightRequest="250" 
                   Aspect="AspectFill" 
                   Margin="0,0,0,12" />

            <Label Text="{Binding Course.Name}" 
                   FontAttributes="Bold" 
                   FontSize="20" 
                   TextColor="#79B791" />

            <Label Text="{Binding Course.Description}" 
                   FontSize="18"
                   TextColor="#000000" />

            <Label FontSize="16">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Datum: " FontAttributes="Bold" />
                        <Span Text="{Binding Course.Date}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label FontSize="16">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Uhrzeit: " FontAttributes="Bold" />
                        <Span Text="{Binding Course.Time}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label FontSize="16">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Alter: " FontAttributes="Bold" />
                        <Span Text="{Binding Course.Age}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label FontSize="16">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Materialien: " FontAttributes="Bold" />
                        <Span Text="{Binding Course.Materials}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
